# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── JIRA ───────────────────────────────────────────────────────────────────────
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...          # From id.atlassian.com → Security → API tokens

# ── Confluence ─────────────────────────────────────────────────────────────────
CONFLUENCE_DOMAIN=https://your-org.atlassian.net
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=...    # From id.atlassian.com → Security → API tokens

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...        # Fine-grained PAT with read access to target repos
GITHUB_ORG=your-org         # Optional: default org for queries

# ── Notion ─────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...     # Internal integration token from notion.so/my-integrations
