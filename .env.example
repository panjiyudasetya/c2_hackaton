# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── JIRA ───────────────────────────────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=you@example.com
JIRA_API_TOKEN=...          # From id.atlassian.com → Security → API tokens

# ── Confluence ─────────────────────────────────────────────────────────────────
CONFLUENCE_URL=https://your-org.atlassian.net
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_TOKEN=...    # Can reuse the JIRA_API_TOKEN above — Jira and
                            # Confluence share Atlassian Cloud auth.

# ── GitHub ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...        # Fine-grained PAT with read access to target repos
GITHUB_ORG=your-org         # Optional: default org for queries

# ── Notion ─────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...     # Internal integration token from notion.so/my-integrations
